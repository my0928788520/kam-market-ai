# Copy to .env for local-only settings. Never commit .env or credentials.
KAM_ENV=development
KAM_TIMEZONE=Asia/Taipei
KAM_DATABASE_PATH=data/kam_shadow.db
KAM_LOG_LEVEL=INFO

# Safety invariant. The application rejects any value other than false.
TRADING_ENABLED=False

# Local-only Fubon authorization settings. Keep every value blank in this template.
# The CLI defaults to dry-run and will not log in while KAM_FUBON_DRY_RUN=True.
KAM_FUBON_DRY_RUN=True
FUBON_NEO_PERSONAL_ID=
FUBON_NEO_PASSWORD=
FUBON_NEO_CERT_PATH=
FUBON_NEO_CERT_PASSWORD_MODE=CUSTOM
FUBON_NEO_CERT_PASSWORD=

# Optional LINE alert settings. Keep real values only in the local .env.
KAM_LINE_CHANNEL_ACCESS_TOKEN=
KAM_LINE_RECIPIENT_USER_ID=
