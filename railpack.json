{
    "$schema":  "https://schema.railpack.com",
    "provider":  "python",
    "packages":  {
                     "python":  "3.12"
                 },
    "steps":  {
                  "install":  {
                                  "commands":  [
                                                   "...",
                                                   "python -m pip install ."
                                               ],
                                  "deployOutputs":  [
                                                        {
                                                            "include":  [
                                                                            "."
                                                                        ]
                                                        }
                                                    ]
                              }
              },
    "deploy":  {
                   "variables":  {
                                     "PYTHONPATH":  "/app/src"
                                 }
               }
}
